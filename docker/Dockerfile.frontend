FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

COPY requirements.txt ./requirements.txt
RUN pip install --upgrade pip && pip install -r requirements.txt streamlit

COPY . .

EXPOSE 8501

CMD ["python", "scripts/run_streamlit.py"]
